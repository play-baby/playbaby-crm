# Django secret key (required in production; falls back to dev-only key if empty)
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (set to True only in development)
DJANGO_DEBUG=True

# Comma-separated allowed hosts (default: localhost,127.0.0.1)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Admin password for seed_data.py (used when creating initial admin user)
DJANGO_ADMIN_PASSWORD=admin123456

# Comma-separated CSRF trusted origins (required in production with HTTPS)
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=
